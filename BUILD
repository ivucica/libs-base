objc_library(
    name = "gnustep-base",
    srcs = glob(
        [
            "Source/*.m",
            "Source/*.c",
            "Source/*.h",
            "Source/Additions/unicode/*.h",
            "Source/Additions/*.m",
            "Source/Additions/*.c",
            "Source/Additions/*.h",
            "Source/GSSocksParser/*.m",
            "Source/GSSocksParser/*.h",
            "Source/unix/*.m",
            "Source/unix/*.h",
        ],
        allow_empty = True,
        exclude = BASE_EXCLUDED_SRCS,
    ) + [
        ":gen_config_h",
        ":gen_dynamic_load_h",
        ":gen_gnustepbase_config_h",
    ],
    hdrs = glob([
        "Headers/CoreFoundation/*.h",
        "Headers/Foundation/*.h",
        "Headers/GNUstepBase/*.h",
        "Tools/*.h",
    ]) + [
        "Source/GSConcreteValueTemplate.m",
        "Source/NSCallBacks.h",
        "Source/NSKeyValueMutableArray.m",
        "Source/NSKeyValueMutableSet.m",
        "Source/simple-load.h",
        ":gen_config_h",
        ":gen_dynamic_load_h",
        ":gen_gnustepbase_config_h",
        ":gen_gsconfig_h",
    ],
    copts = [
        "-DGNUSTEP",
        "-DGNUSTEP_BASE_LIBRARY=1",
        "-DGNUSTEP_BASE_INTERNAL=1",
        "-DGNU_RUNTIME=1",
        "-D_NATIVE_OBJC_EXCEPTIONS=1",
        "-DGSWARN",
        "-DGSDIAGNOSE",
        "-DGNUSTEP_IS_FLATTENED=\"yes\"",
        "-DLIBRARY_COMBO=\"ng-gnu-gnu\"",
        "-Wno-deprecated-declarations",
        "-Wno-implicit-function-declaration",
        "-Wno-int-conversion",
        "-Wno-incompatible-pointer-types",
        "-Wno-unused-but-set-variable",
        "-Wno-unused-function",
        "-Wno-unused-variable",
        "-Wno-format",
        "-Wno-switch",
    ] + gnustep_target_copts(),
    defines = [
        "GNUSTEP",
        "GNUSTEP_BASE_LIBRARY=1",
        "GNU_RUNTIME=1",
        "_NATIVE_OBJC_EXCEPTIONS=1",
        "GSWARN",
        "GSDIAGNOSE",
    ],
    includes = [
        ".bazel/include",
        ".bazel/include/GNUstepBase",
        "Headers",
        "Headers/Foundation",
        "Headers/GNUstepBase",
        "Source",
        "Source/Additions",
    ],
    linkopts = gnustep_platform_linkopts() + [
    ],
    deps = [
        "@libxml2//:libxml2",
        "@icu//icu4c/source/common:platform",
        "@icu//icu4c/source/i18n:collation",
        "@libffi//:libffi",
        "@libobjc2//:objc",
        "@zlib//:zlib",
    ],
)

